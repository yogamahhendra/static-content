# ==========================================
# Static Content Management System (.env.example)
# ==========================================

# Base Application URL
APP_BASE_URL=http://localhost:3000

# ------------------------------------------
# Database Configuration (Neon PostgreSQL)
# Free tier: 1 GB storage, 100 CU-hrs, no credit card required
# Obtain from: https://console.neon.tech -> Project Dashboard -> Connection Details
# ------------------------------------------
DATABASE_URL=postgresql://neondb_owner:your_password@ep-cool-sample.us-east-2.aws.neon.tech/neondb?sslmode=require

# ------------------------------------------
# Authentication & Security
# ------------------------------------------
# Generate a strong 32+ character random string (e.g., openssl rand -base64 32)
AUTH_SECRET=your_super_secret_jwt_key_at_least_32_chars_long

# Initial Admin Seeding Credentials (used by pnpm run seed)
ADMIN_INITIAL_EMAIL=superadmin@test.com
ADMIN_INITIAL_PASSWORD=Pa$$word12345

# Audit Logging Toggle (set to false to disable recording audit logs)
ENABLE_AUDIT_LOGS=true

# ------------------------------------------
# Object Storage (Neon Object Storage / S3-Compatible)
# Free tier: 5 GB per project, 5 GB egress, standard S3 wire protocol
# Compatible alternatives: Supabase Storage, Cloudflare R2, MinIO
# ------------------------------------------
S3_ENDPOINT=https://your-branch-id.storage.neon.tech
S3_REGION=us-east-2
S3_ACCESS_KEY_ID=your_s3_access_key_id
S3_SECRET_ACCESS_KEY=your_s3_secret_access_key
S3_BUCKET_NAME=static-assets
S3_FORCE_PATH_STYLE=true

# ------------------------------------------
# File Optimization & Processing Constraints
# ------------------------------------------
MAX_UPLOAD_SIZE_MB=10
IMAGE_MAX_WIDTH=1920
IMAGE_MAX_HEIGHT=1920
IMAGE_DEFAULT_QUALITY=80